      "expression" : "if (steam_readings.size < 2) {\n    return { \"SteamConsumptionRate\": 0.0 };\n}\n\nvar p = null;\nvar c = null;\nvar readingValue = 0.0;\n\nforeach (reading : steam_readings.values) {\n    readingValue = reading.value;\n    if (!isNaN(readingValue) && readingValue != 0) {\n        p = c;\n        c = reading;\n    }\n}\n\nif (p == null || c == null) {\n    return { \"SteamConsumptionRate\": 0.0 };\n}\n\nvar prev = p.value;\nvar curr = c.value;\nif (isNaN(prev) || isNaN(curr)) {\n    return { \"SteamConsumptionRate\": 0.0 };\n}\nvar dtHours = (c.ts - p.ts) / 3600000.0;\nif (dtHours <= 0) {\n    return { \"SteamConsumptionRate\": 0.0 };\n}\nvar delta = 0.0;\nif (curr < prev) {\n    delta = (curr >= 0 ? curr : 0.0);\n} else {\n    delta = curr - prev;\n}\nreturn { \"SteamConsumptionRate\": toFixed(delta / dtHours, 4) };"
